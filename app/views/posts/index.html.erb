<div class="hero-section mb-5">
  <h1 class="display-4 fw-bold">Welcome to Peanut Blog</h1>
  <p class="lead text-muted">A modern space for sharing ideas and stories.</p>
</div>

<div class="row g-4">
  <% @posts.each do |post| %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 card-hover border-0 shadow-sm">
        <div class="card-body d-flex flex-column">
          <div class="mb-2">
            <% if post.categories.any? %>
              <% post.categories.each do |category| %>
                <span class="badge rounded-pill bg-light text-primary border"><%= category.name %></span>
              <% end %>
            <% end %>
          </div>
          
          <h3 class="card-title h5 fw-bold mb-3">
            <%= link_to post.title, post_path(post), class: "text-dark text-decoration-none stretched-link" %>
          </h3>
          
          <p class="card-text text-muted flex-grow-1">
            <%= truncate(post.description, length: 120) %>
          </p>
          
          <div class="d-flex align-items-center mt-3 pt-3 border-top">
            <div class="d-flex align-items-center">
              <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                <%= post.user.username[0].upcase %>
              </div>
              <small class="text-muted">
                <%= link_to post.user.username, user_path(post.user), class: "text-decoration-none text-muted fw-medium position-relative", style: "z-index: 2;" %>
                <span class="mx-1">&bull;</span>
                <%= time_ago_in_words(post.created_at) %> ago
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="flickr_pagination my-5">
  <%= will_paginate @posts, :container => false %>
</div>
